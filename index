<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Another Your Life</title>
</head>
<body>

<h1>Another Your Life</h1>

<div id="status"></div>
<img id="image" width="300">
<div id="event"></div>
<div id="choices"></div>

<script>

let state = {
  age: 15,
  money: 50,
  hp: 100,
  happiness: 50,
  partner: null,
  alive: true
};

function advanceTime() {
  state.age++;

  // 老化強化
  if (state.age > 40) state.hp -= 3;
  if (state.age > 60) state.hp -= 6;
  if (state.age > 80) state.hp -= 10;

  // 強制死亡
  if (state.hp <= 0 || state.age > 90) {
    state.alive = false;
  }
}

// 安定画像（確実に出る）
function getImage(seed) {
  return `https://source.unsplash.com/300x300/?${seed}`;
}

const EVENTS = [

  {
    text: "今日はどうする？",
    image: "student",
    choices: [
      {
        text: "勉強",
        effect: s => {
          s.hp -= 3;
          advanceTime();
        }
      },
      {
        text: "遊ぶ",
        effect: s => {
          s.happiness += 5;
          if (Math.random() < 0.4) s.partner = "恋人";
          advanceTime();
        }
      }
    ]
  },

  {
    condition: s => s.partner,
    text: s => `${s.partner}と過ごす`,
    image: "couple",
    choices: [
      {
        text: "楽しむ",
        effect: s => {
          s.happiness += 10;
          advanceTime();
        }
      },
      {
        text: "ケンカ",
        effect: s => {
          s.happiness -= 10;
          advanceTime();
        }
      }
    ]
  },

  {
    text: "仕事のストレス",
    image: "office",
    choices: [
      {
        text: "頑張る",
        effect: s => {
          s.money += 20;
          s.hp -= 10;
          advanceTime();
        }
      },
      {
        text: "逃げる",
        effect: s => {
          s.hp += 5;
          advanceTime();
        }
      }
    ]
  },

  {
    text: "事故が起きた（運命）",
    image: "accident",
    auto: true,
    effect: s => {
      let d = Math.random();

      if (d < 0.3) {
        s.hp -= 50;
      } else if (d < 0.6) {
        s.hp -= 20;
      }

      advanceTime();
      return "運命が動いた";
    }
  }

];

function pickEvent() {
  const valid = EVENTS.filter(e => !e.condition || e.condition(state));
  return valid[Math.floor(Math.random() * valid.length)];
}

function draw() {

  if (!state.alive) {
    document.getElementById("event").innerText =
      `あなたは${state.age}歳で死亡した`;
    document.getElementById("choices").innerHTML = "";
    return;
  }

  document.getElementById("status").innerText =
    `年齢:${state.age} HP:${state.hp} 幸福:${state.happiness}`;

  const event = pickEvent();

  document.getElementById("event").innerText =
    typeof event.text === "function" ? event.text(state) : event.text;

  document.getElementById("image").src =
    getImage(event.image || "life");

  const div = document.getElementById("choices");
  div.innerHTML = "";

  if (event.auto) {
    const r = event.effect(state);
    const btn = document.createElement("button");
    btn.innerText = r + " → 次へ";
    btn.onclick = draw;
    div.appendChild(btn);
    return;
  }

  event.choices.forEach(c => {
    const btn = document.createElement("button");
    btn.innerText = c.text;

    btn.onclick = () => {
      c.effect(state);
      draw();
    };

    div.appendChild(btn);
  });
}

draw();

</script>

</body>
</html>
